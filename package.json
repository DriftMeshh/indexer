{
  "name": "@driftmeshh/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for DriftMesh: indexes device/reading/claim/subscription events from the Soroban contracts and serves them over a REST API.",
  "type": "module",
  "workspaces": [
    "bindings/*"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build --workspaces --if-present && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.1.0",
    "better-sqlite3": "^11.7.0",
    "device-registry": "*",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
