{
  "name": "@driftmeshh/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for DriftMesh: indexes device/reading/claim/subscription events from the Soroban contracts and serves them over a REST API.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "bindings/*"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "npm run build --workspaces --if-present && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "migrate": "node-pg-migrate up --migrations-dir migrations --database-url-var DATABASE_URL",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.1.0",
    "device-registry": "*",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.3",
    "payment-streamer": "*",
    "pg": "^8.23.1",
    "submission-validator": "*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
