# Soroban RPC endpoint. Horizon is being phased out in favor of this; note
# that RPC only retains ~7 days of event history, so a long gap between
# deploying contracts and first running the indexer means backfill is not
# possible without a third-party indexer or running Galexie.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract IDs from `stellar contract deploy` in the contracts repo.
DEVICE_REGISTRY_CONTRACT_ID=
SUBMISSION_VALIDATOR_CONTRACT_ID=
PAYMENT_STREAMER_CONTRACT_ID=
SUBSCRIPTION_MARKET_CONTRACT_ID=

# PostgreSQL connection string.
# For local development: spin up Postgres with Docker or use a system install.
#   docker run --rm -e POSTGRES_PASSWORD=driftmesh -e POSTGRES_USER=driftmesh \
#              -e POSTGRES_DB=driftmesh -p 5432:5432 postgres:16
# Migrations are applied automatically on startup via node-pg-migrate.
DATABASE_URL=postgresql://driftmesh:driftmesh@127.0.0.1:5432/driftmesh

POLL_INTERVAL_MS=5000
PORT=3001
